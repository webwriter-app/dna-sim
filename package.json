{
  "name": "@webwriter/dna-sim",
  "version": "1.0.1",
  "repository": "https://github.com/webwriter-app/dna-sim",
  "description": "Simulate DNA replication, transcription, and translation in phases, including animations.",
  "keywords": [
    "webwriter-widget",
    "widget-simulational",
    "widget-practical",
    "widget-lang-en-US",
    "widget-lang-en-GB",
    "widget-lang-en-CA",
    "widget-lang-en-AU",
    "widget-lang-en-IN",
    "widget-lang-de-DE",
    "widget-lang-de-AT",
    "widget-lang-de-CH",
    "Biology",
    "DNA",
    "Gene Expression",
    "widget-lang-en",
    "widget-lang-de",
    "widget-lang-yue-Hans",
    "widget-lang-yue-Hant",
    "widget-lang-kmr",
    "widget-lang-kmr-Latn",
    "widget-lang-kmr-Arab",
    "widget-lang-ckb",
    "widget-lang-ckb-Arab",
    "widget-lang-af-ZA",
    "widget-lang-af-NA"
  ],
  "license": "MIT",
  "author": "Jeremy Poroye",
  "scripts": {
    "prepublishOnly": "npx @webwriter/build",
    "dev": "npx @webwriter/build dev",
    "localize": "node localization/build-locales.mjs",
    "typecheck": "tsc --noEmit",
    "localize:translate": "lit-localize extract && npx @webwriter/build localize && npm run localize",
    "test": "node tests/chrome-regression.mjs"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2",
    "@shoelace-style/shoelace": "^2.20.1",
    "@webwriter/lit": "^3.0.0",
    "lit": "^3"
  },
  "devDependencies": {
    "@lit/localize-tools": "^0.8",
    "@webwriter/build": "^1.13.1"
  },
  "overrides": {
    "@aidenlx/esbuild-plugin-inline-worker": {
      "esbuild": "0.25.12",
      "nanoid": "3.3.20"
    }
  },
  "exports": {
    "./widgets/webwriter-dna-simulation.*": {
      "source": "./widgets/webwriter-dna-simulation.ts",
      "default": "./dist/widgets/webwriter-dna-simulation.*"
    },
    "./icon": "./icon.svg",
    "./editing-config.json": "./editing-config.json",
    "./snippets/dna-simulation.html": "./snippets/dna-simulation.html",
    "./custom-elements.json": "./custom-elements.json"
  },
  "editingConfig": {
    "./snippets/dna-simulation": {}
  },
  "customElements": "custom-elements.json"
}
